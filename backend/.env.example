# Server Configuration
PORT=8080

# Storage Configuration
STORAGE_PATH=./tmp/uploads

# AI Service Configuration
# Replace with your actual AI service URL and API key
AI_SERVICE_URL=https://api.replicate.com/v1/predictions
AI_SERVICE_KEY=your_api_key_here

# Mock AI Service (set to true for testing without API calls)
# When enabled, returns a placeholder image immediately without calling the AI service
MOCK_AI_SERVICE=false

# File Upload Configuration
# Max upload size is hardcoded to 10MB in the application

# Cleanup Configuration
# Files are automatically cleaned up after 60 minutes

# Email Service Configuration
# For testing, use Mailtrap.io (free, safe, emails don't actually send)
# Get credentials from: https://mailtrap.io/inboxes
# Or use Gmail with App Password: https://support.google.com/accounts/answer/185833
ENABLE_EMAIL=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
FROM_EMAIL=noreply@virtualfitcheck.com
BASE_URL=http://localhost:8080

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtualfitcheck?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE=5
